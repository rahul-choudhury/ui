#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
required_bun_version="1.3.11"
export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$PATH"

step() {
  printf '[orb setup] %s\n' "$1"
  SECONDS=0
}

done_step() {
  printf '[orb setup] completed in %ss\n' "$SECONDS"
}

step "Ensuring Bun $required_bun_version is installed"
if ! command -v bun >/dev/null 2>&1 || [[ "$(bun --version)" != "$required_bun_version" ]]; then
  curl -fsSL https://bun.sh/install | bash -s "bun-v$required_bun_version"
fi
done_step

profile_marker="# @rahul-choudhury/ui Bun"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# @rahul-choudhury/ui Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
EOF
fi

step "Installing locked dependencies"
cd "$repo_root"
bun install --frozen-lockfile
done_step

printf '[orb setup] Ready\n'
